# ==============================================================================
# Veltra Frontend Environment Configuration
# ==============================================================================

# Canonical Backend REST API URL (Required in production)
# Example: https://api.veltra.example.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Legacy compatibility alias (automatically fallback if NEXT_PUBLIC_API_URL is unset)
NEXT_PUBLIC_API=http://localhost:4000

# Optional: Dedicated WebSocket Server URL (defaults to NEXT_PUBLIC_API_URL if unset)
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
