{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest",
    "/node_modules/(.*/node_modules/)?(@scure/base|@noble/hashes)/.+\\.js$": [
      "ts-jest",
      {
        "isolatedModules": true,
        "tsconfig": {
          "allowJs": true,
          "module": "commonjs",
          "moduleResolution": "node10",
          "verbatimModuleSyntax": false
        }
      }
    ],
    "^.+\\.js$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(.*/node_modules/)?(@scure/base|@noble/hashes)/)"
  ],
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  }
}
